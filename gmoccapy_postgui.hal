# Generated by PNCconf at Tue Sep  2 11:25:11 2025
# Using LinuxCNC version:  Master (2.9)
# If you make changes to this file, they will be
# overwritten when you run PNCconf again

#  ---manual tool change signals to gmoccapy's dialog---

net tool-change-request    => gmoccapy.toolchange-change
net tool-change-confirmed  <= gmoccapy.toolchange-changed
net tool-number            => gmoccapy.toolchange-number
net tool-change-prepare-button-done gmoccapy.toolchange-confirm

#  ---signals to show tool offset in the GUI---

net tooloffset-x gmoccapy.tooloffset-x <= motion.tooloffset.x
net tooloffset-z gmoccapy.tooloffset-z <= motion.tooloffset.z

#  ---spindle-at-speed indicator---

net spindle-at-speed => gmoccapy.spindle_at_speed_led
net spindle-speed-out => gmoccapy.spindle_feedback_bar

# --- JOG-X-POS ---
net jog-x-pos  gmoccapy.jog.axis.jog-x-plus

# --- JOG-X-NEG ---
net jog-x-neg  gmoccapy.jog.axis.jog-x-minus

# --- JOG-Y-POS ---
net jog-y-pos  gmoccapy.jog.axis.jog-y-plus

# --- JOG-Y-NEG ---
net jog-y-neg  gmoccapy.jog.axis.jog-y-minus

# --- JOG-Z-POS ---
net jog-z-pos  gmoccapy.jog.axis.jog-z-plus

# --- JOG-Z-NEG ---
net jog-z-neg  gmoccapy.jog.axis.jog-z-minus

net rapid-feed-button gmoccapy.jog.turtle-jog

net jog-incr-0 gmoccapy.jog.jog-inc-0 demux.0.out-00
net jog-incr-1 gmoccapy.jog.jog-inc-1 demux.0.out-01
net jog-incr-2 gmoccapy.jog.jog-inc-2 demux.0.out-02
net jog-incr-3 gmoccapy.jog.jog-inc-3 demux.0.out-03
net jog-incr-4 gmoccapy.jog.jog-inc-4 demux.0.out-04
net jog-incr-5 gmoccapy.jog.jog-inc-5 demux.0.out-05
net jog-incr-6 gmoccapy.jog.jog-inc-6 demux.0.out-06

net jog-speed-plus gmoccapy.spc_lin_jog_vel.increase

net jog-speed-minus gmoccapy.spc_lin_jog_vel.decrease

# --- HYDRAULIC MONITORING ---
net hydraulic-monitoring gmoccapy.messages.hydraulic-monitoring

# --- SAFETYY DOOR MONITORING K161 ---
net safety-door-monitoring gmoccapy.messages.safety-door-monitoring

# --- TEMPERATURE MONITORING ---
net temperature-monitoring gmoccapy.messages.temperature-monitoring

# --- GEARBOX TIMEOUT ---
net gearbox-timeout gmoccapy.messages.gearbox-timeout

# --- FEED DRIVE CURRENT LIMIT I2XT ---
net feed-drive-current-limit gmoccapy.messages.feed-drive-current-limit

setp gmoccapy.feed.feed-override.count-enable 1
setp gmoccapy.spindle.spindle-override.count-enable 1
setp gmoccapy.rapid.rapid-override.count-enable 1
net feed-enc-counts   	 hm2_7i92.0.7i77.0.0.enc0.count gmoccapy.feed.feed-override.counts
net spindle-enc-counts	 hm2_7i92.0.7i77.0.0.enc1.count gmoccapy.spindle.spindle-override.counts
net rapid-enc-counts 	 hm2_7i92.0.7i84.0.2.enc0.count gmoccapy.rapid.rapid-override.counts
